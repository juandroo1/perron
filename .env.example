# Copy to .env and fill in. Secrets and environment only;
# benchmark methodology (model, effort, max_tokens, pauses) lives in bench/bench.json.

# transport.opendata.ch REST API (no key required)
TRANSPORT_API_BASE=https://transport.opendata.ch/v1/

# Anthropic API key for Perron Bench (agent loop, judge, token counting)
ANTHROPIC_API_KEY=

# Optional: free API key from opentransportdata.swiss for swiss-transport-mcp (stm).
# If empty, stm is skipped and the report says so.
STM_TRANSPORT_API_KEY=

# Optional: Perron MCP endpoint for Perron Bench when run outside Docker.
# Default http://localhost:8080/mcp; docker-compose.yml sets http://mcp:8080/mcp for the bench container.
# PERRON_MCP_URL=http://localhost:8080/mcp

# Optional: variant of Perron MCP for the ablations (plan.md, section 4). Defaults shown;
# the server reports the variant in serverInfo (perron-rich, perron-minimal, perron-json …).
# Invalid values stop the start.
# PERRON_TOOLS=standard
# PERRON_DESCRIPTIONS=rich
# PERRON_FORMAT=compact
