# Copy to .env and fill in. Secrets and environment only;
# benchmark methodology (model, effort, max_tokens, pauses) lives in bench/bench.json.

# transport.opendata.ch REST API (no key required)
TRANSPORT_API_BASE=https://transport.opendata.ch/v1/

# Anthropic API key for Perron Bench (agent loop, judge, token counting)
ANTHROPIC_API_KEY=

# Optional: free API key from opentransportdata.swiss for swiss-transport-mcp (stm).
# If empty, stm is skipped and the report says so.
STM_TRANSPORT_API_KEY=
