    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Search Swiss Stops & Stations"
      },
      "description": "Search for Swiss public transport stops and stations by name.\n\n    Searches across all Swiss public transport stops (train stations,\n    tram/bus stops, boat stations). Returns stop IDs needed for\n    transport_departures and transport_trip_plan.\n\n    Returns:\n        Matching stops with id, name, coordinates, and transport modes.\n    ",
      "inputSchema": {
        "properties": {
          "params": {
            "$ref": "#/$defs/SearchStopInput"
          }
        },
        "required": [
          "params"
        ],
        "type": "object",
        "$defs": {
          "SearchStopInput": {
            "additionalProperties": false,
            "description": "Input for searching stops/stations.",
            "properties": {
              "query": {
                "description": "Search text for stop name (e.g., 'Zürich HB', 'Bern Bahnhof', 'Winterthur')",
                "maxLength": 200,
                "minLength": 2,
                "title": "Query",
                "type": "string"
              },
              "limit": {
                "default": 10,
                "description": "Maximum number of results (1–20)",
                "maximum": 20,
                "minimum": 1,
                "title": "Limit",
                "type": "integer"
              }
            },
            "required": [
              "query"
            ],
            "title": "SearchStopInput",
            "type": "object"
          }
        },
        "title": "transport_search_stopArguments"
      },
