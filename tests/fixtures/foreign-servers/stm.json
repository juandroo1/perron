        "openWorldHint": true,
        "readOnlyHint": true,
        "title": "Plan a Journey (Swiss ÖV)"
      },
      "description": "Plan a journey between two locations in Switzerland.\n\n    Works like the SBB app: enter origin and destination (stop IDs or\n    place names), get multiple trip options with transfers, durations,\n    and transport modes.\n\n    For best results, use stop IDs from transport_search_stop.\n    Place names (addresses) also work but may be slower.\n\n    Returns:\n        Trip options, each with legs (individual journey segments),\n        total duration, number of transfers, and transport modes used.\n    ",
      "inputSchema": {
        "properties": {
          "params": {
            "$ref": "#/$defs/TripPlanInput"
          }
        },
        "required": [
          "params"
        ],
        "type": "object",
        "$defs": {
          "TripPlanInput": {
            "additionalProperties": false,
            "description": "Input for planning a journey between two locations.",
            "properties": {
              "origin": {
                "description": "Start location. Either a stop ID (e.g., '8503000' for Zürich HB) or a place name (e.g., 'Langstrasse 100, Zürich'). Use transport_search_stop first for exact stop IDs.",
                "minLength": 1,
                "title": "Origin",
                "type": "string"
              },
              "destination": {
                "description": "End location. Either a stop ID or a place name. Use transport_search_stop first for exact stop IDs.",
                "minLength": 1,
                "title": "Destination",
                "type": "string"
              },
              "time": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Departure time in ISO 8601. Defaults to now.",
                "title": "Time"
              },
              "limit": {
                "default": 5,
                "description": "Number of trip options (1–6)",
                "maximum": 6,
                "minimum": 1,
                "title": "Limit",
                "type": "integer"
              }
            },
            "required": [
              "origin",
              "destination"
            ],
            "title": "TripPlanInput",
            "type": "object"
