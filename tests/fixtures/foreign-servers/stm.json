            "$ref": "#/$defs/SearchStopByCoordInput"
          }
        },
        "required": [
          "params"
        ],
        "type": "object",
        "$defs": {
          "SearchStopByCoordInput": {
            "additionalProperties": false,
            "description": "Input for finding nearby stops by coordinates.",
            "properties": {
              "latitude": {
                "description": "Latitude (WGS84), e.g. 47.3769 for Zürich HB",
                "maximum": 48.5,
                "minimum": 45.0,
                "title": "Latitude",
                "type": "number"
              },
              "longitude": {
                "description": "Longitude (WGS84), e.g. 8.5417 for Zürich HB",
                "maximum": 10.8,
