        "readOnlyHint": true,
        "title": "Live Departures at a Stop"
      },
      "description": "Get upcoming departures or arrivals at a Swiss public transport stop.\n\n    Shows real-time information including delays when available.\n    Like a digital departure board at a train station.\n\n    Use transport_search_stop first to get the stop_id.\n\n    Returns:\n        Departures with line, destination, scheduled time, real-time time,\n        delay, and platform.\n    ",
      "inputSchema": {
        "properties": {
          "params": {
            "$ref": "#/$defs/DeparturesInput"
          }
        },
        "required": [
          "params"
        ],
        "type": "object",
        "$defs": {
          "DeparturesInput": {
            "additionalProperties": false,
            "description": "Input for fetching departures/arrivals at a stop.",
            "properties": {
              "stop_id": {
                "description": "Stop ID from transport_search_stop (e.g., '8503000' for Zürich HB). Use transport_search_stop first to find the ID.",
                "minLength": 1,
                "title": "Stop Id",
                "type": "string"
              },
              "stop_name": {
                "default": "",
                "description": "Optional stop name for display purposes",
                "title": "Stop Name",
                "type": "string"
              },
              "time": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Departure time in ISO 8601 (e.g., '2026-03-01T08:00:00Z'). Defaults to now.",
                "title": "Time"
              },
              "limit": {
                "default": 10,
                "description": "Number of departures to show (1–30)",
                "maximum": 30,
                "minimum": 1,
                "title": "Limit",
                "type": "integer"
              },
              "event_type": {
                "default": "departure",
                "description": "'departure' or 'arrival'",
                "pattern": "^(departure|arrival)$",
                "title": "Event Type",
                "type": "string"
              }
            },
            "required": [
              "stop_id"
