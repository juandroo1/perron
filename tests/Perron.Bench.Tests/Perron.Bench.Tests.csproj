<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <!-- Task sets, available at <output>/tasks for the format tests. -->
  <ItemGroup>
    <None Include="..\..\bench\tasks\*.jsonl" LinkBase="tasks" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Server registry and settings, available at <output>/bench for the registry and check tests. -->
  <ItemGroup>
    <None Include="..\..\bench\servers.json;..\..\bench\bench.json" LinkBase="bench" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Perron.Bench\Perron.Bench.csproj" />
    <!-- Perron MCP runs in memory as the server under check. Alias: both projects define a global Program class. -->
    <ProjectReference Include="..\..\src\Perron.Mcp\Perron.Mcp.csproj" Aliases="PerronMcp" />
  </ItemGroup>

</Project>
